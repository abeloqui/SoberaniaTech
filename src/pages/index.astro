---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CursoCard from '../components/CursoCard.astro';
import { SITE_TAGLINE, REPO_URL, url } from '../config';

const cursos = await getCollection('cursos');
const destacados = cursos
  .filter((c) => c.data.destacado)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 3);
---

<Layout>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-teal-50 to-white">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:py-24">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900">
        Soberanía<span class="text-amber-500">Tech</span>
      </h1>
      <p class="mt-4 max-w-2xl text-xl text-slate-700">{SITE_TAGLINE}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={url('/cursos')} class="rounded-lg bg-teal-700 px-5 py-3 font-semibold text-white hover:bg-teal-800">
          Ver cursos
        </a>
        <a href={url('/contribuir')} class="rounded-lg border border-teal-700 px-5 py-3 font-semibold text-teal-700 hover:bg-teal-50">
          Quiero contribuir
        </a>
      </div>
    </div>
  </section>

  <!-- Explicación -->
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-2xl font-bold text-slate-900">¿Qué es SoberaníaTech?</h2>
    <p class="mt-3 max-w-3xl text-slate-700">
      Un portal de cursos cortos y prácticos para quienes trabajan en el transporte de personal,
      la logística y la actividad hidrocarburífera de Neuquén. Todo es gratuito, sin registro,
      sin rastreadores y construido con software libre.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      <div class="rounded-xl bg-slate-50 p-5">
        <h3 class="font-bold text-teal-700">Gratuito</h3>
        <p class="mt-2 text-sm text-slate-600">Sin costo, sin cuentas y sin publicidad.</p>
      </div>
      <div class="rounded-xl bg-slate-50 p-5">
        <h3 class="font-bold text-teal-700">Abierto</h3>
        <p class="mt-2 text-sm text-slate-600">Código y contenidos libres: usalos, copialos y mejoralos.</p>
      </div>
      <div class="rounded-xl bg-slate-50 p-5">
        <h3 class="font-bold text-teal-700">Local</h3>
        <p class="mt-2 text-sm text-slate-600">Pensado para la realidad de Neuquén y Vaca Muerta.</p>
      </div>
    </div>
  </section>

  <!-- Cursos destacados -->
  <section class="mx-auto max-w-5xl px-4 py-8">
    <div class="flex items-end justify-between">
      <h2 class="text-2xl font-bold text-slate-900">Cursos destacados</h2>
      <a href={url('/cursos')} class="text-sm font-medium text-teal-700 underline">Ver todos</a>
    </div>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {destacados.map((c) => (
        <CursoCard id={c.id} {...c.data} />
      ))}
    </div>
  </section>

  <!-- Contribuir -->
  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="rounded-2xl bg-teal-700 p-8 text-white">
      <h2 class="text-2xl font-bold">Este portal lo construimos entre todos</h2>
      <p class="mt-3 max-w-2xl text-teal-50">
        ¿Sabés de seguridad, logística, programación o simplemente explicar cosas claro?
        Un curso nuevo es un archivo Markdown. No hace falta ser programador.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={url('/contribuir')} class="rounded-lg bg-amber-400 px-5 py-3 font-semibold text-slate-900 hover:bg-amber-300">
          Cómo contribuir
        </a>
        <a href={REPO_URL} class="rounded-lg border border-white px-5 py-3 font-semibold hover:bg-teal-800">
          Ver el código
        </a>
      </div>
    </div>
  </section>
</Layout>