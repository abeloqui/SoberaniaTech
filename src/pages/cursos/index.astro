---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CursoCard from '../../components/CursoCard.astro';

const cursos = (await getCollection('cursos')).sort((a, b) => a.data.orden - b.data.orden);
---

<Layout title="Cursos" description="Todos los cursos gratuitos de SoberaníaTech.">
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-3xl font-extrabold text-slate-900">Cursos</h1>
    <p class="mt-2 text-slate-600">
      Cursos cortos, prácticos y gratuitos. Sin registro.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {cursos.map((c) => (
        <CursoCard id={c.id} {...c.data} />
      ))}
    </div>
  </section>
</Layout>