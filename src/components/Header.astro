---
import { SITE_NAME, url } from '../config';

const links = [
  { href: '/cursos', label: 'Cursos' },
  { href: '/contribuir', label: 'Contribuir' },
  { href: '/sobre-el-proyecto', label: 'Sobre el proyecto' },
];
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-5xl px-4 py-4 flex flex-wrap items-center justify-between gap-3">
    <a href={url('/')} class="text-xl font-bold text-teal-700">
      Soberanía<span class="text-amber-500">Tech</span>
      <span class="sr-only">{SITE_NAME}</span>
    </a>
    <nav class="flex flex-wrap gap-4 text-sm font-medium">
      {links.map((l) => (
        <a href={url(l.href)} class="text-slate-600 hover:text-teal-700">{l.label}</a>
      ))}
    </nav>
  </div>
</header>