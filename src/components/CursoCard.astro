---
import { url } from '../config';

interface Props {
  id: string;
  title: string;
  description: string;
  categoria: string;
  nivel: string;
  duracion: string;
}

const { id, title, description, categoria, nivel, duracion } = Astro.props;
---

<a
  href={url(`/cursos/${id}`)}
  class="block rounded-xl border border-slate-200 p-5 hover:border-teal-600 hover:shadow-md transition"
>
  <span class="inline-block rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold text-teal-700">
    {categoria}
  </span>
  <h3 class="mt-3 text-lg font-bold text-slate-900">{title}</h3>
  <p class="mt-2 text-sm text-slate-600">{description}</p>
  <p class="mt-4 text-xs text-slate-500">{nivel} · {duracion}</p>
</a>